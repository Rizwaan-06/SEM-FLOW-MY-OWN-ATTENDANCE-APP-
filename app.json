{
  "expo": {
    "name": "SemFlow",
    "slug": "semflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rizwaan.semflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F3EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rizwaan.semflow"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "description": "An offline-first academic planner for attendance, GPA estimates, schedules, homework, and practice.",
    "scheme": "semflow",
    "experiments": {
      "typedRoutes": true
    }
  }
}
